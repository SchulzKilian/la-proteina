# PGF + LaTeX
pgf.texsystem: pdflatex
pgf.rcfonts: false
text.usetex: true
font.family: serif
font.serif: Computer Modern Roman

# 12pt document — match exactly
font.size: 12
axes.labelsize: 12
axes.titlesize: 12
legend.fontsize: 10
xtick.labelsize: 10
ytick.labelsize: 10

# Clean defaults
axes.linewidth: 0.5
lines.linewidth: 1.0
grid.linewidth: 0.4
xtick.major.width: 0.5
ytick.major.width: 0.5

# Save settings
figure.dpi: 150
savefig.bbox: tight
savefig.pad_inches: 0.02
savefig.format: pdf
